@final
class RankwidthAnnealer:
    def __init__(
        self,
        graph: VecGraph,
        seed: int | None = None,
        init_decomp: DecompTree | None = None,
        init_temp: float | None = None,
        min_temp: float | None = None,
        cooling_rate: float | None = None,
        adaptive_cooling: bool | None = None,
        iterations: int | None = None,
    ) -> None: ...
    @property
    def init_decomp(self) -> DecompTree: ...
    @init_decomp.setter
    def init_decomp(self, value: DecompTree) -> None: ...
    @property
    def init_temp(self) -> float: ...
    @init_temp.setter
    def init_temp(self, value: float) -> None: ...
    @property
    def min_temp(self) -> float: ...
    @min_temp.setter
    def min_temp(self, value: float) -> None: ...
    @property
    def cooling_rate(self) -> float: ...
    @cooling_rate.setter
    def cooling_rate(self, value: float) -> None: ...
    @property
    def adaptive_cooling(self) -> bool: ...
    @adaptive_cooling.setter
    def adaptive_cooling(self, value: bool) -> None: ...
    @property
    def iterations(self) -> int: ...
    @iterations.setter
    def iterations(self, value: int) -> None: ...
    def run(self) -> DecompTree: ...

