class SimpFunc(Enum):
    FullSimp = ...
    CliffordSimp = ...
    NoSimp = ...

@final
class Decomposer:
    @staticmethod
    def empty() -> Decomposer: ...
    def __init__(
        self,
        g: VecGraph,
        *,
        use_driver: str | None = None,
        save: bool | None = None,
        simp: SimpFunc | None = None,
    ) -> None: ...
    def done(self) -> list[VecGraph]: ...
    def with_simp(self, simp: SimpFunc) -> None: ...
    def with_full_simp(self) -> None: ...
    def with_clifford_simp(self) -> None: ...
    def with_split_graph_components(self, b: bool) -> None: ...
    def with_save(self, b: bool) -> None: ...
    def max_terms(self) -> int: ...
    def decompose(
        self,
        driver_type: str = "BssWithCats",
        random_t: bool = False,
        sherlock_tries=[],
    ) -> None: ...
    def decompose_parallel(
        self,
        *,
        allow_threads: bool = True,
        driver_type: str = "BssWithCats",
        random_t: bool = False,
        sherlock_tries=[],
    ) -> None: ...
    def decompose_until_depth(
        self,
        depth: int,
        driver_type: str = "BssWithCats",
        random_t: bool = False,
        sherlock_tries=[],
    ) -> None: ...
    def get_nterms(self) -> int: ...
    def get_scalar(self) -> Scalar: ...

